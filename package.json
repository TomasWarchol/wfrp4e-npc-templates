{
  "name": "wfrp4e-npc-templates",
  "private": true,
  "type": "module",
  "description": "Narzędzia deweloperskie modułu. Nie trafiają do module.zip. Kompendium buduje `npm run packs`.",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "node tools/validate-module.mjs",
    "check": "npm run validate && npm run lint && npm run test",
    "link": "node tools/link-foundry.mjs",
    "package": "node tools/package-module.mjs",
    "lang:add": "node tools/add-language.mjs",
    "packs": "node tools/build-packs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundryvtt/foundryvtt-cli": "^3.0.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "vitest": "^5.1.0"
  }
}
